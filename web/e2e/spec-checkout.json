   "target": "checkout.details",
   "excerpt": "#[spec(\"checkout.details\")]\npub fn collect_details(o: &mut Order, form: Form) -> Result<State> {\n    let addr = Address::parse(&form.address).map_err(|e| Error::Field(e.field))?;\n    o.address = Some(addr);\n    Ok(State::Paying)\n}"
  },
