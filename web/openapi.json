{
  "openapi": "3.1.0",
  "info": {
    "title": "spectrace API",
    "version": "0.1.0"
  },
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "github_id": {
            "type": "integer"
          },
          "login": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "avatar_url": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "github_id",
          "login",
          "name",
          "avatar_url"
        ]
      },
      "GithubRepo": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "installation_id": {
            "type": "integer"
          },
          "owner": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "full_name": {
            "type": "string"
          },
          "private": {
            "type": "boolean"
          },
          "default_branch": {
            "type": "string"
          },
          "html_url": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "installation_id",
          "owner",
          "name",
          "full_name",
          "private",
          "default_branch",
          "html_url"
        ]
      },
      "Project": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "context": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          },
          "repos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProjectRepo"
            }
          }
        },
        "required": [
          "id",
          "name",
          "context",
          "created_at",
          "updated_at",
          "repos"
        ]
      },
      "ProjectRepo": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "github_repo_id": {
            "type": "integer",
            "nullable": true
          },
          "full_name": {
            "type": "string"
          },
          "default_branch": {
            "type": "string"
          },
          "index_state": {
            "type": "string",
            "enum": [
              "pending",
              "indexing",
              "ready",
              "failed"
            ]
          }
        },
        "required": [
          "id",
          "github_repo_id",
          "full_name",
          "default_branch",
          "index_state"
        ]
      },
      "Job": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "projectId": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed"
            ]
          },
          "attempts": {
            "type": "integer"
          },
          "maxAttempts": {
            "type": "integer"
          },
          "error": {
            "type": "string",
            "nullable": true
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "finishedAt": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "projectId",
          "kind",
          "target",
          "state",
          "attempts",
          "maxAttempts",
          "error",
          "createdAt",
          "updatedAt",
          "finishedAt"
        ]
      },
      "Pull": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "repo": {
            "type": "string",
            "example": "acme/shop"
          },
          "number": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "open",
              "merged",
              "closed"
            ]
          },
          "draft": {
            "type": "boolean"
          },
          "needsYou": {
            "type": "boolean",
            "description": "Open, not a draft, and not yet handled by you."
          },
          "headRef": {
            "type": "string"
          },
          "baseRef": {
            "type": "string"
          },
          "htmlUrl": {
            "type": "string"
          },
          "additions": {
            "type": "integer"
          },
          "deletions": {
            "type": "integer"
          },
          "changedFiles": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          },
          "mergedAt": {
            "type": "string",
            "nullable": true
          },
          "syncedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "repo",
          "number",
          "title",
          "author",
          "state",
          "draft",
          "needsYou",
          "headRef",
          "baseRef",
          "htmlUrl",
          "additions",
          "deletions",
          "changedFiles",
          "createdAt",
          "updatedAt",
          "mergedAt",
          "syncedAt"
        ]
      },
      "PullCounts": {
        "type": "object",
        "properties": {
          "needs": {
            "type": "integer"
          },
          "open": {
            "type": "integer"
          },
          "merged": {
            "type": "integer"
          }
        },
        "required": [
          "needs",
          "open",
          "merged"
        ],
        "description": "Size of each inbox tab, over every repo of the project."
      },
      "PullDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Pull"
          },
          {
            "type": "object",
            "properties": {
              "body": {
                "type": "string"
              },
              "headSha": {
                "type": "string"
              },
              "files": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/PullFile"
                }
              }
            },
            "required": [
              "body",
              "headSha",
              "files"
            ]
          }
        ]
      },
      "PullFile": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "previousPath": {
            "type": "string",
            "nullable": true
          },
          "additions": {
            "type": "integer"
          },
          "deletions": {
            "type": "integer"
          }
        },
        "required": [
          "path",
          "status",
          "previousPath",
          "additions",
          "deletions"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Liveness plus a database round trip",
        "responses": {
          "200": {
            "description": "The Worker and its database are up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "service": {
                      "type": "string"
                    },
                    "database": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  },
                  "required": [
                    "status",
                    "service",
                    "database"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "The database is unreachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/github/login": {
      "get": {
        "summary": "Start GitHub sign-in (redirects to GitHub)",
        "responses": {
          "303": {
            "description": "Redirect to GitHub"
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/github/callback": {
      "get": {
        "summary": "GitHub redirects back here; starts a session",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "code",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "state",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "error",
            "in": "query"
          }
        ],
        "responses": {
          "303": {
            "description": "Signed in, redirect to /"
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "GitHub failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "summary": "The signed-in user",
        "responses": {
          "200": {
            "description": "The user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "summary": "Sign out",
        "responses": {
          "204": {
            "description": "Session ended (also when there was none)"
          }
        }
      }
    },
    "/api/github/install": {
      "get": {
        "summary": "Start installing the GitHub App (redirects to GitHub)",
        "responses": {
          "303": {
            "description": "Redirect to GitHub's install page"
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "App not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/github/install/callback": {
      "get": {
        "summary": "GitHub redirects back here after the App is installed",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "nullable": true
            },
            "required": false,
            "name": "installation_id",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "setup_action",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "code",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "state",
            "in": "query"
          }
        ],
        "responses": {
          "303": {
            "description": "Redirect to /?github_app=installed (or =requested)"
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "GitHub failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/github/repos": {
      "get": {
        "summary": "Repositories the signed-in user's installations can reach",
        "responses": {
          "200": {
            "description": "Repositories, sorted by full name",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GithubRepo"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "GitHub failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/projects": {
      "get": {
        "summary": "My projects",
        "responses": {
          "200": {
            "description": "Projects with their repositories",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Project"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a project",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "context": {
                    "type": "string"
                  },
                  "repos": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "github_repo_id": {
                          "type": "integer",
                          "nullable": true
                        },
                        "full_name": {
                          "type": "string"
                        },
                        "default_branch": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "full_name"
                      ]
                    }
                  }
                },
                "required": [
                  "name"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The new project",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/projects/{id}": {
      "get": {
        "summary": "One project",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The project",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No such project",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Change a project",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "context": {
                    "type": "string"
                  },
                  "repos": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "github_repo_id": {
                          "type": "integer",
                          "nullable": true
                        },
                        "full_name": {
                          "type": "string"
                        },
                        "default_branch": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "full_name"
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The changed project",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Project"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No such project",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a project and its repositories",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No such project",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/projects/{id}/repos": {
      "post": {
        "summary": "Add a repository to a project",
        "description": "Accepts owner/repo or a GitHub link. The repository must be one the GitHub App is installed on for the signed-in user, and not already in the project.",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "repo": {
                    "type": "string",
                    "description": "owner/repo, or a link to the repository on GitHub",
                    "example": "acme/shop"
                  }
                },
                "required": [
                  "repo"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The attached repository",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectRepo"
                }
              }
            }
          },
          "400": {
            "description": "Empty, or not owner/repo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Not reachable through the user's GitHub App installations",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No such project",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Already in this project",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "GitHub failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/projects/{id}/repos/{repoId}": {
      "delete": {
        "summary": "Remove a repository from a project",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": true,
            "name": "repoId",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "Removed"
          },
          "401": {
            "description": "Not signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No such project",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/projects/{projectId}/jobs": {
      "post": {
        "summary": "Queue a job for a project (owner only)",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,64}$"
            },
            "required": true,
            "name": "projectId",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9._-]{0,63}$"
                  },
                  "target": {
                    "type": "string",
                    "maxLength": 512,
                    "default": ""
                  },
                  "maxAttempts": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10,
                    "default": 3
                  }
                },
                "required": [
                  "kind"
                ]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
