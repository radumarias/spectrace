# Copy to .dev.vars (git-ignored) for `just dev`. Create an OAuth app at
# https://github.com/settings/developers with callback URL
# http://localhost:5173/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Where the browser reaches the app; the callback is PUBLIC_URL + /api/auth/github/callback
PUBLIC_URL=http://localhost:5173
# GitHub App (see README, "GitHub App"). Its Client ID/secret can be the two above.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# The .pem, on one line with \n for line breaks
GITHUB_APP_PRIVATE_KEY=
# The App's webhook secret; set the same string on the App (Webhook URL: PUBLIC_URL + /api/github/webhook)
GITHUB_WEBHOOK_SECRET=
