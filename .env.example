# Copy to .env (git-ignored). The justfile loads it automatically.
DATABASE_URL=postgres://spectrace:spectrace@localhost:5432/spectrace
BIND_ADDR=127.0.0.1:8080
LOG_FORMAT=pretty
RUST_LOG=info

# GitHub sign-in (set both, or neither). Create an OAuth app at
# https://github.com/settings/developers with callback URL
# http://localhost:5173/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Where the browser reaches the app; the callback is PUBLIC_URL + /api/auth/github/callback
PUBLIC_URL=http://localhost:5173

# GitHub App (T1.2): lets spectrace list and read the repos you install it on.
# Set all three, or none. Create the app at https://github.com/settings/apps/new:
#   - Setup URL: http://localhost:5173/api/github/install/callback
#     and tick "Request user authorization (OAuth) during installation"
#   - Callback URL: http://localhost:5173/api/auth/github/callback
#   - Webhook: untick Active for now, or set a secret and use it below
#   - Repository permissions: Contents (read), Pull requests (read & write),
#     Metadata (read). Installable by any account, or only yours.
# Then use the app's Client ID and a client secret for GITHUB_CLIENT_ID and
# GITHUB_CLIENT_SECRET above (the app does sign-in too).
GITHUB_APP_ID=
GITHUB_APP_SLUG=
# The downloaded .pem: either its path, or the key with newlines written as \n
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
